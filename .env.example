# ============================================================
# WACore - Configuration
# ============================================================
# Copia este archivo como .env y ajusta los valores

# --- Instance ---
WA_INSTANCE_NAME=bot-dev
CONNECT_ON_STARTUP=true
# Single-line mode: with an empty session registry, create the WA_INSTANCE_NAME session.
# Multi-tenant deployments (lines created through the API) set it to false.
LEGACY_SESSION_ENABLED=true
QR_TIMEOUT=60000
# Rondas de QR sin escanear tras las que la sesión se rinde. Solo afecta a las que nunca
# llegaron a emparejarse: una con credenciales reintenta siempre.
QR_MAX_ROUNDS=3

# --- Health ---
HEALTH_PORT=9877
API_PORT=9878

# --- Logging ---
LOG_LEVEL=info
# Formato de logs: json (production) | pretty (dev, legible con colores).
# Por defecto: pretty si stdout es TTY, json en caso contrario.
# LOG_FORMAT=pretty

# --- Session Store ---
# Opciones: file | redis | postgres
SESSION_STORE=file
SESSION_DIR=/data/sessions
REDIS_URL=redis://redis:6379
# DATABASE_URL=postgres://wacore:wacore@localhost:5432/wacore

# --- Webhook ---
# WEBHOOK_URL=https://mi-servicio-ia.com/webhook/whatsapp
# WEBHOOK_SECRET=mi-clave-secreta-hmac
WEBHOOK_EVENTS=message,connection,qr
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY=5000

# --- REST API ---
# La API_KEY es necesaria para habilitar la API REST
# API_KEY=mi-api-key-segura

# --- Incoming Message Delivery ---
POLLING_ENABLED=true
SSE_ENABLED=true
MESSAGE_BUFFER_SIZE=1000
MESSAGE_BUFFER_TTL_MS=300000
SSE_HEARTBEAT_MS=30000

# --- Forward cache (raw baileys messages for /messages/forward) ---
FORWARD_CACHE_MAX=5000
FORWARD_CACHE_TTL_MS=86400000

# --- Own messages (fromMe) ---
# Publish what goes OUT of the line as well, not just what comes in. Off by default:
# the consumer must know how to drop the echo of its own sends, which arrive with
# origin:"api". What a person writes from the phone arrives with origin:"device".
WACORE_PUBLISH_FROM_ME=false
# Native buttons and lists (POST /api/send-buttons, /api/send-list). OFF on purpose:
# these are the OLD interactive formats. Many WhatsApp clients render them as plain
# text, and on non-Business numbers using them is one of the signals that leads to a
# ban. Turn it on knowingly, and keep fallbackToText enabled on each request.
WACORE_INTERACTIVE_MESSAGES=false
# Auto-reject incoming calls. OFF by default: hanging up on a customer is a business
# decision, and without this the call simply rings with nobody picking it up. The record
# in the conversation is stored either way — that is the part that matters.
AUTO_REJECT_CALLS=false
# Keys of sent messages kept per session so their echo can be told apart.
SENT_REGISTRY_MAX=10000
SENT_REGISTRY_TTL_MS=3600000

# --- Presence & Typing ---
AUTO_TYPING=true
TYPING_DURATION_MS=3000

# --- Read Receipts ---
# If true, mark all incoming messages as read automatically
AUTO_READ=false

# --- Media Download ---
MEDIA_DIR=/data/media
MEDIA_AUTO_DOWNLOAD=true
MEDIA_BASE_URL=http://localhost:9878

# --- Histórico al emparejar ---
#   Al vincular una línea, WhatsApp entrega meses de conversaciones. Se importan en silencio:
#   sin marcar mensajes sin leer, sin descargar adjuntos y sin reordenar la bandeja.
# HISTORY_SYNC_ENABLED=true
# HISTORY_MAX=5000
#   Tope por sesión. Una cuenta con años de conversaciones no puede tumbar el arranque.
# HISTORY_BATCH_SIZE=200
# HISTORY_BATCH_DELAY_MS=250
#   Goteo: diez mil mensajes de golpe saturan al consumidor.
#   Se entrega por webhook con WEBHOOK_EVENTS=...,history (eventos message.history y history.synced).

# --- Environment ---
NODE_ENV=development
