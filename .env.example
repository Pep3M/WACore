# ============================================================
# WACore - Configuration
# ============================================================
# Copia este archivo como .env y ajusta los valores

# --- Instance ---
WA_INSTANCE_NAME=bot-dev
CONNECT_ON_STARTUP=true
QR_TIMEOUT=60000

# --- Health ---
HEALTH_PORT=9877
API_PORT=9878

# --- Logging ---
LOG_LEVEL=info

# --- Session Store ---
# Opciones: file | redis | postgres
SESSION_STORE=file
SESSION_DIR=/data/sessions
REDIS_URL=redis://redis:6379

# --- Webhook ---
# WEBHOOK_URL=https://mi-servicio-ia.com/webhook/whatsapp
# WEBHOOK_SECRET=mi-clave-secreta-hmac
WEBHOOK_EVENTS=message,connection,qr
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY=5000

# --- REST API ---
# Si no se define, la API REST permanece deshabilitada
# API_KEY=mi-api-key-segura

# --- Environment ---
NODE_ENV=development
